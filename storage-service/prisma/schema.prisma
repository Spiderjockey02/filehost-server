datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
}

model User {
  id                String    @id @default(cuid())
  name              String
  email             String   @unique
  image             String?
  emailVerified     Boolean
  languageCode      String        @default("en-GB")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt
  sessions          Session[]
  accounts          Account[]
  notifications     Notification[]
  recentlyViewed    RecentlyViewedFile[]
  files             File[]
  activity          UserActivity[]
  groupId           String?
  group             Group?  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  totalStorageSize  BigInt  @default(0)
  role              String  @default("user")
  storage           StorageMedium    @relation(fields: [storageId], references: [id])
  storageId         String
}

model Session {
  id              String   @id
  expiresAt       DateTime
  token           String
  createdAt       DateTime
  updatedAt       DateTime
  ipAddress       String?  @db.Text
  userAgent       String?  @db.Text
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy  String?
  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @db.Text
  providerId            String    @db.Text
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id	          String	@id
  identifier	  String
  value	        String  @db.VarChar(500)
  expiresAt	    DateTime
  createdAt	    DateTime
  updatedAt	    DateTime
}

model Group {
  id              String    @id     @default(cuid())
  name            String    @unique
  users           User[]
  maxStorageSize  BigInt       @default(5368709120)
}

model Notification {
  id          String    @id             @default(cuid())
  createdAt   DateTime  @default(now())
  text        String
  title       String
  url         String?
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum FileType {
  FILE
  DIRECTORY
}

model File {
  id          String    @id @default(cuid())
  path        String
  name        String
  size        BigInt
  type        FileType  @default(FILE)    
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  children    File[]    @relation("FileToParent")
  parent      File?     @relation("FileToParent", fields: [parentId], references: [id])
  parentId    String?   
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  mediatype   MediaType? @relation(fields: [mimetype], references: [name])
  mimetype    String?
  storage     StorageMedium    @relation(fields: [storageId], references: [id])
  storageId   String
  recentlyViewedBy  RecentlyViewedFile[]

  @@unique([path, userId])
}

enum StorageType {
  FILE_SYSTEM
  S3
}

model StorageMedium {
  id          String      @id     @default(cuid())
  type        StorageType
  name        String
  basePath    String
  latitude    Float?
  longitude   Float?
  endpoint    String?
  maxSize     BigInt      @default(0)
  usedSize    BigInt      @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  files       File[]
  users       User[]
}

model MediaType {
  name        String  @id
  files       File[]
}

model RecentlyViewedFile {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  file        File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  fileId      String
  viewedAt    DateTime @default(now())

  @@unique([fileId, userId])
}

enum Status {
  SUCCESS
  FAILURE
}

model CronJobLog {
  id        Int         @id   @default(autoincrement())
  status    Status
  message   String?
  ranAt     DateTime    @default(now())
  duration  Int?        @default(0)
  cronJob   CronJob     @relation(fields: [jobName], references: [name], onDelete: Cascade)
  jobName   String
}

model CronJob {
  name          String        @id
  latestStatus  Status? 
  CronJobLog    CronJobLog[]
  schedule      String    @default("0 * * * *")
}

model UserActivity {
  id            String   @id          @default(cuid())
  methodType    ActivityMethod        @relation(fields: [method], references: [method], onDelete: Cascade)
  method        HTTPMethod
  endpoint      String
  responseCode  ActivityStatusCode    @relation(fields: [statusCode], references: [code], onDelete: Cascade)
  statusCode    Int
  incomingBytes Int
  outgoingBytes Int
  ipCon         IpAddress?    @relation(fields: [ipAddress], references: [ip], onDelete: SetNull)
  ipAddress     String?
  UserAgentCon  UserAgent?    @relation(fields: [userAgent], references: [agent], onDelete: SetNull)
  userAgent     String?
  durationMs    Int
  createdAt     DateTime      @default(now())
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId        String?
}

model ActivityStatusCode {
  code          Int       @id
  history       UserActivity[]
}

enum HTTPMethod {
  CONNECT
  DELETE
  GET
  HEAD
  OPTIONS
  PATCH
  POST
  PUT
  TRACE
}

model ActivityMethod {
  method        HTTPMethod      @id
  history       UserActivity[]
}

model IpAddress {
  ip        String      @id
  country   String?
  city      String?
  latitude  Float?
  longitude Float?
  isp       String?
  isVPN     Boolean    @default(false)
  isCrawler Boolean    @default(false)
  activity  UserActivity[]
}

model UserAgent {
  agent           String    @id
  browserName     String?
  browserVersion  String?
  osName          String?
  osVersion       String?
  isBot           Boolean   @default(false)
  activity        UserActivity[]
}