datasource db {
  provider = "mysql"
}

generator client {
  provider        = "prisma-client"
  output          = "../src/types/generated"
}

model User {
  id                String    @id @default(cuid())
  name              String
  email             String   @unique
  image             String?
  emailVerified     Boolean
  languageCode      String        @default("en-GB")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt
  sessions          Session[]
  accounts          Account[]
  notifications     Notification[]
  recentlyViewed    RecentlyViewedFile[]
  files             File[]
  activity          UserActivity[]
  logs              AuditLog[]
  auditListeners    AuditLogListener[]
  bans              UserBans[]  @relation("bannedUser")
  issuedBans        UserBans[]  @relation("issuedUser")
  banned            Boolean     @default(false)
  plan              Plan        @relation(fields: [planId], references: [id])
  planId            String
  totalStorageSize  BigInt  @default(0)
  role              String  @default("user")
  storage           StorageMedium    @relation(fields: [storageId], references: [id])
  storageId         String
  twoFactorEnabled  Boolean   @default(false)
  isMigrating       Boolean   @default(false)
  stripeCustomerId  String?

  @@index([planId])
  @@index([storageId])
  @@index([role])
  @@index([createdAt])
}

model Session {
  id              String   @id
  expiresAt       DateTime
  token           String
  createdAt       DateTime
  updatedAt       DateTime
  ipAddress       String?  @db.Text
  userAgent       String?  @db.Text
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy  String?

  @@unique([token])
  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @db.Text
  providerId            String    @db.Text
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
  @@index([providerId(length: 191)])
  @@index([accountId(length: 191)])
  @@map("account")
}

model Verification {
  id	          String	@id
  identifier	  String
  value	        String  @db.VarChar(500)
  expiresAt	    DateTime
  createdAt	    DateTime
  updatedAt	    DateTime

  @@index([identifier])
  @@index([expiresAt])
}

model Notification {
  id          String    @id             @default(cuid())
  createdAt   DateTime  @default(now())
  text        String    @db.LongText
  title       String
  url         String?
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

enum FileType {
  FILE
  DIRECTORY
}

model File {
  id          String    @id @default(cuid())
  path        String
  name        String
  size        BigInt
  type        FileType  @default(FILE)    
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  children    File[]    @relation("FileToParent")
  parent      File?     @relation("FileToParent", fields: [parentId], references: [id])
  parentId    String?   
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  mediatype   MediaType? @relation(fields: [mimetype], references: [name])
  mimetype    String?
  storage     StorageMedium    @relation(fields: [storageId], references: [id])
  storageId   String
  recentlyViewedBy  RecentlyViewedFile[]
  metadata    FileMetadata?

  @@unique([path, userId])
  @@index([userId])
  @@index([parentId])
  @@index([storageId])
  @@index([deletedAt])
  @@index([mimetype])
}

model FileMetadata {
  id                String    @id       @default(uuid())
  file              File      @relation(fields: [fileId], references: [id], onDelete: Cascade)
  fileId            String    @unique
  originalCreatedAt DateTime?
  width             Int?
  height            Int?
  duration          Float?
  frameRate         Float?
  cameraModel       String?
  gpsLatitude       Float?
  gpsLongitude      Float?
  codec             String?
  exif              Json?
}

enum StorageType {
  FILE_SYSTEM
  SFTP
  S3
}

model StorageMedium {
  id            String      @id     @default(cuid())
  type          StorageType
  name          String
  basePath      String
  location      String     @default("Europe")
  endpoint      String?
  maxSize       BigInt      @default(0)
  usedSize      BigInt      @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  isPrivate     Boolean     @default(false)
  avatarOnly    Boolean     @default(false)

  files         File[]
  users         User[]
}

model MediaType {
  name        String  @id
  files       File[]
}

model RecentlyViewedFile {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  file        File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  fileId      String
  viewedAt    DateTime @default(now())

  @@unique([fileId, userId])
  @@index([userId])
  @@index([fileId])
}

enum Status {
  SUCCESS
  FAILURE
}

model CronJobLog {
  id        Int         @id   @default(autoincrement())
  status    Status
  message   String      @db.LongText
  ranAt     DateTime    @default(now())
  duration  Int?        @default(0)
  cronJob   CronJob     @relation(fields: [jobName], references: [name], onDelete: Cascade)
  jobName   CronJobNames

  @@index([jobName])
  @@index([ranAt])
}

enum CronJobNames {
  BACKED_UP_DATABASE
  DELETE_OLD_BACKUPS
  DELETE_OLD_LOG_FILES
  DELETE_EXPIRED_SESSIONS
  RECALCULATE_USER_STORAGE
  RECALCULATE_STORAGE_USAGE
  DELETE_OLD_TRASHED_FILES
}

model CronJob {
  name          CronJobNames    @id
  latestStatus  Status? 
  CronJobLog    CronJobLog[]
  schedule      String    @default("0 * * * *")
}

enum HTTPMethod {
  CONNECT
  DELETE
  GET
  HEAD
  OPTIONS
  PATCH
  POST
  PUT
  TRACE
}

model UserActivity {
  id            String   @id          @default(cuid())
  method        HTTPMethod
  endpoint      String
  statusCode    Int
  incomingBytes Int
  outgoingBytes Int
  ipCon         IpAddress?    @relation(fields: [ipAddress], references: [ip], onDelete: SetNull)
  ipAddress     String?
  UserAgentCon  UserAgent?    @relation(fields: [userAgent], references: [agent], onDelete: SetNull)
  userAgent     String?
  durationMs    Int
  createdAt     DateTime      @default(now())
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId        String?

  @@index([userId])
  @@index([statusCode])
  @@index([method])
  @@index([ipAddress])
  @@index([userAgent])
  @@index([createdAt])
}

model IpAddress {
  ip        String      @id
  country   String?
  city      String?
  latitude  Float?
  longitude Float?
  isp       String?
  isVPN     Boolean    @default(false)
  isCrawler Boolean    @default(false)
  
  activity        UserActivity[]
  logs            AuditLog[]
}

model UserAgent {
  agent           String    @id
  browserName     String?
  browserVersion  String?
  osName          String?
  osVersion       String?
  isBot           Boolean   @default(false)

  activity        UserActivity[]
  logs            AuditLog[]
}

enum AuditLogResourceType {
  FILE
  USER
  STORAGE
  SYSTEM
  SESSION
  SUBSCRIPTION
  EMAIL
}

enum AuditLogEventName {
  FILE_UPLOAD
  FILE_DOWNLOAD
  FILE_RENAME
  FILE_COPY
  FILE_MOVE
  FILE_DELETE
  FILE_TRASHED
  FILE_RECOVERED_ALL
  FILE_RECOVERED
  FILE_VIEWED
  FOLDER_CREATE
  NOTIFICATION_SENT
  CRONJOB_RAN
  USER_REGISTERED
  USER_LOGIN
  USER_UPDATE
  USER_AVATAR_CHANGE
  USER_TWOFA_CHANGE
  USER_PASSWORD_RESET
  SYSTEM_ONLINE
  RATE_LIMIT_ABUSE
  STORAGE_CREATED
  STORAGE_UPDATED
  STORAGE_DELETED
  LISTENER_CREATED
  LISTENER_DELETED
  LISTENER_UPDATED
  PLAN_CREATED
  PLAN_UPDATED
  PLAN_DELETED
  SUBSCRIPTION_START
  SUBSCRIPTION_ENDED
  EMAIL_SENT
  CONFIG_UPDATED
}

model AuditLogNames {
  name          AuditLogEventName        @id
  resourceType  AuditLogResourceType
  displayName   String?
  logs          AuditLog[]
  subscriptions AuditLogEventSubscription[]

  @@index([resourceType])
}

model AuditLog {
  id           String         @id @default(cuid())
  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId       String?
  event        AuditLogNames  @relation(fields: [eventId], references: [name], onDelete: Cascade)
  eventId      AuditLogEventName
  message      String?        @db.LongText
  resourceId   String?
  success      Boolean
  ipCon        IpAddress?     @relation(fields: [ipAddress], references: [ip], onDelete: SetNull)
  ipAddress    String?
  userAgentCon UserAgent?     @relation(fields: [userAgent], references: [agent], onDelete: SetNull)
  userAgent    String?
  createdAt    DateTime       @default(now())

  @@index([eventId])
  @@index([userId])
  @@index([createdAt])
}

enum ListenerType {
  WEBHOOK
  NOTIFICATION
}

model AuditLogListener {
  id          String        @id @default(cuid())
  admin       User          @relation(fields: [adminId], references: [id], onDelete: Cascade)
  adminId     String
  name        String
  enabled     Boolean        @default(true)
  type        ListenerType
  targetUrl   String?
  events      AuditLogEventSubscription[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([adminId])
}

model AuditLogEventSubscription {
  id           String           @id @default(cuid())
  listener     AuditLogListener @relation(fields: [listenerId], references: [id], onDelete: Cascade)
  listenerId   String
  event        AuditLogNames    @relation(fields: [eventId], references: [name], onDelete: Cascade)
  eventId      AuditLogEventName

  @@unique([listenerId, eventId])
  @@index([eventId])
}

model UserBans {
  id            String    @id   @default(cuid())
  user          User      @relation("bannedUser", fields: [userId], references: [id])
  userId        String
  issuedByUser  User      @relation("issuedUser", fields: [issuedBy], references: [id])
  issuedBy      String
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  reason        String
}

model Plan {
  id                        String    @id       @default(cuid())
  name                      String
  maxStorageSize            BigInt    @default(5368709120)
  maxFileSize               BigInt    @default(2147483648)
  deletedFileRetentionDays  Int       @default(30)
  price                     Decimal   @default(0.00)
  priceId                   String?
  isDefault                 Boolean   @default(false)
  users                     User[]
}

model twoFactor {
  id              String    @id   @default(cuid())
  userId          String
  secret          String
  backupCodes     String    @db.Text
}

enum SubscriptionStatus {
  trialing
  active
  incomplete
  incomplete_expired
  past_due
  canceled
  unpaid
  paused
}

model subscription {
  id                    String    @id   @default(cuid())
  plan	                String
  referenceId	          String
  stripeCustomerId	    String?
  stripeSubscriptionId	String?
  status	              SubscriptionStatus
  periodStart	          DateTime?
  periodEnd	            DateTime?
  cancelAtPeriodEnd	    Boolean?
  seats	                Int?
  trialStart            DateTime?
  trialEnd              DateTime?
}