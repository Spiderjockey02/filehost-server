datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
}

model User {
  id                String    @id @default(cuid())
  name              String
  email             String   @unique
  image             String?
  emailVerified     Boolean
  languageCode      String        @default("en-GB")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt
  sessions          Session[]
  accounts          Account[]
  notifications     Notification[]
  recentlyViewed    RecentlyViewedFile[]
  files             File[]
  activity          UserActivity[]
  logs              AuditLog[]
  bans              UserBans[]  @relation("bannedUser")
  issuedBans        UserBans[]  @relation("issuedUser")
  plan              Plan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  planId            String
  totalStorageSize  Int  @default(0)
  role              String  @default("user")
  storage           StorageMedium    @relation(fields: [storageId], references: [id])
  storageId         String
  twoFactorEnabled  Boolean   @default(false)

  @@index([planId])
  @@index([storageId])
  @@index([role])
  @@index([createdAt])
}

model Session {
  id              String   @id
  expiresAt       DateTime
  token           String
  createdAt       DateTime
  updatedAt       DateTime
  ipAddress       String?  @db.Text
  userAgent       String?  @db.Text
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy  String?

  @@unique([token])
  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @db.Text
  providerId            String    @db.Text
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
  @@index([providerId(length: 191)])
  @@index([accountId(length: 191)])
  @@map("account")
}

model Verification {
  id	          String	@id
  identifier	  String
  value	        String  @db.VarChar(500)
  expiresAt	    DateTime
  createdAt	    DateTime
  updatedAt	    DateTime

  @@index([identifier])
  @@index([expiresAt])
}

model Notification {
  id          String    @id             @default(cuid())
  createdAt   DateTime  @default(now())
  text        String
  title       String
  url         String?
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

enum FileType {
  FILE
  DIRECTORY
}

model File {
  id          String    @id @default(cuid())
  path        String
  name        String
  size        Int
  type        FileType  @default(FILE)    
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  children    File[]    @relation("FileToParent")
  parent      File?     @relation("FileToParent", fields: [parentId], references: [id])
  parentId    String?   
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  mediatype   MediaType? @relation(fields: [mimetype], references: [name])
  mimetype    String?
  storage     StorageMedium    @relation(fields: [storageId], references: [id])
  storageId   String
  recentlyViewedBy  RecentlyViewedFile[]

  @@unique([path, userId])
  @@index([userId])
  @@index([parentId])
  @@index([storageId])
  @@index([deletedAt])
  @@index([mimetype])
}

enum StorageType {
  FILE_SYSTEM
  S3
}

model StorageMedium {
  id            String      @id     @default(cuid())
  type          StorageType
  name          String
  basePath      String
  location      String     @default("Europe")
  endpoint      String?
  maxSize       Int      @default(0)
  usedSize      Int      @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  isPrivate     Boolean     @default(false)
  avatarOnly    Boolean     @default(false)

  files         File[]
  users         User[]
}

model MediaType {
  name        String  @id
  files       File[]
}

model RecentlyViewedFile {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  file        File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  fileId      String
  viewedAt    DateTime @default(now())

  @@unique([fileId, userId])
  @@index([userId])
  @@index([fileId])
}

enum Status {
  SUCCESS
  FAILURE
}

model CronJobLog {
  id        Int         @id   @default(autoincrement())
  status    Status
  message   String
  ranAt     DateTime    @default(now())
  duration  Int?        @default(0)
  cronJob   CronJob     @relation(fields: [jobName], references: [name], onDelete: Cascade)
  jobName   String

  @@index([jobName])
  @@index([ranAt])
}

model CronJob {
  name          String        @id
  latestStatus  Status? 
  CronJobLog    CronJobLog[]
  schedule      String    @default("0 * * * *")
}

enum HTTPMethod {
  CONNECT
  DELETE
  GET
  HEAD
  OPTIONS
  PATCH
  POST
  PUT
  TRACE
}

model UserActivity {
  id            String   @id          @default(cuid())
  method        HTTPMethod
  endpoint      String
  statusCode    Int
  incomingBytes Int
  outgoingBytes Int
  ipCon         IpAddress?    @relation(fields: [ipAddress], references: [ip], onDelete: SetNull)
  ipAddress     String?
  UserAgentCon  UserAgent?    @relation(fields: [userAgent], references: [agent], onDelete: SetNull)
  userAgent     String?
  durationMs    Int
  createdAt     DateTime      @default(now())
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId        String?

  @@index([userId])
  @@index([statusCode])
  @@index([method])
  @@index([ipAddress])
  @@index([userAgent])
  @@index([createdAt])
}

model IpAddress {
  ip        String      @id
  country   String?
  city      String?
  latitude  Float?
  longitude Float?
  isp       String?
  isVPN     Boolean    @default(false)
  isCrawler Boolean    @default(false)
  
  activity        UserActivity[]
  logs            AuditLog[]
}

model UserAgent {
  agent           String    @id
  browserName     String?
  browserVersion  String?
  osName          String?
  osVersion       String?
  isBot           Boolean   @default(false)

  activity        UserActivity[]
  logs            AuditLog[]
}

enum AuditLogResourceType {
  FILE
  USER
  STORAGE
  SYSTEM
}

enum AuditLogEventType {
  FILE_UPLOAD
  FILE_DOWNLOAD
  FILE_RENAME
  FILE_COPY
  FILE_MOVE
  FILE_DELETE
  FILE_TRASHED
  FILE_RECOVERED
  FOLDER_CREATE
  NOTIFICATION_SENT
  CRONJOB_RAN
  USER_REGISTERED
  USER_LOGIN
  USER_UPDATE
  SYSTEM_ONLINE
}

model AuditLog {
  id           String         @id @default(cuid())
  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId       String?
  eventType    AuditLogEventType
  message      String?
  resourceType AuditLogResourceType
  resourceId   String?
  success      Boolean
  ipCon        IpAddress?    @relation(fields: [ipAddress], references: [ip], onDelete: SetNull)
  ipAddress    String?
  UserAgentCon UserAgent?    @relation(fields: [userAgent], references: [agent], onDelete: SetNull)
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([eventType])
  @@index([resourceType])
  @@index([userId])
  @@index([createdAt])
}

model UserBans {
  id            String    @id   @default(cuid())
  user          User      @relation("bannedUser", fields: [userId], references: [id])
  userId        String
  issuedByUser  User      @relation("issuedUser", fields: [issuedBy], references: [id])
  issuedBy      String
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  reason        String
}

model Plan {
  id              String    @id   @default(cuid())
  name            String
  maxStorageSize  Int    @default(5368709120)
  price           Decimal   @default(0.00)
  isDefault       Boolean   @default(false)
  users           User[]
}

model twoFactor {
  id              String    @id   @default(cuid())
  userId          String
  secret          String
  backupCodes     String
}